{
  "apiType": "stageMode",
  "buildOption": {
    "resOptions": {
      "copyCodeResource": {
        "enable": false
      }
    },
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      "arguments": "",
      "cppFlags": "-std=c++17"
    }
  },
  "buildOptionSet": [
    {
      "name": "debug",
      "nativeLib": {
        "collectAllLibs": true,
        "debugSymbol": {
          "strip": false,
          "exclude": []
        }
      }
    },
    {
      "name": "release",
      "nativeLib": {
        "debugSymbol": {
          "strip": true,
          "exclude": []
        }
      }
    }
  ],
  "targets": [
    { "name": "default" }
  ]
}
